pragma cashscript ^0.13.0;

contract StreamPayV2(
    bytes20 employerPKH,
    bytes20 workerPKH,
    int startTime,
    int endTime,
    int totalDeposit
) {

    function withdraw(sig workerSig, pubkey workerPk, int amount) {

        require(hash160(workerPk) == workerPKH);
        require(checkSig(workerSig, workerPk));

        require(startTime < endTime);
        require(totalDeposit > 0);

        require(tx.locktime >= startTime);

        int minerFee = 1000;
        int dustLimit = 546;

        int remainingBefore = tx.inputs[this.activeInputIndex].value;

        require(remainingBefore <= totalDeposit);

        int withdrawnSoFar = totalDeposit - remainingBefore;

        int duration = endTime - startTime;
        int elapsed = tx.locktime - startTime;
        int unlockedTotal = 0;  

        if (tx.locktime >= endTime) {
            unlockedTotal = totalDeposit;
        } else {
            unlockedTotal = (totalDeposit * elapsed) / duration;
        }
        require(amount > 0);
        require(withdrawnSoFar + amount <= unlockedTotal);
        require(amount + minerFee <= remainingBefore);

        bytes25 workerLock = new LockingBytecodeP2PKH(workerPKH);

        int remainingAfter = remainingBefore - amount - minerFee;

        if (remainingAfter > dustLimit + minerFee) {

            bytes selfLock = tx.inputs[this.activeInputIndex].lockingBytecode;

            require(tx.outputs.length == 2);

            require(tx.outputs[0].value == amount);
            require(tx.outputs[0].lockingBytecode == workerLock);

            require(tx.outputs[1].value == remainingAfter);
            require(tx.outputs[1].lockingBytecode == selfLock);

        } else {
            
            require(tx.outputs.length == 1);

            require(
                tx.outputs[0].value ==
                remainingBefore - minerFee
            );

            require(
                tx.outputs[0].lockingBytecode ==
                workerLock
            );
        }
    }

    function cancel(sig employerSig, pubkey employerPk) {

        require(hash160(employerPk) == employerPKH);
        require(checkSig(employerSig, employerPk));

        require(startTime < endTime);
        require(totalDeposit > 0);

        require(tx.locktime >= startTime);

        int minerFee = 1000;

        int remainingBefore =
            tx.inputs[this.activeInputIndex].value;

        require(remainingBefore <= totalDeposit);

        int withdrawnSoFar =
            totalDeposit - remainingBefore;

        int duration = endTime - startTime;
        int elapsed = tx.locktime - startTime;

        if (elapsed > duration) {
            elapsed = duration;
        }

        int unlockedTotal =
            (totalDeposit * elapsed) / duration;

        int earnedNotWithdrawn =
            unlockedTotal - withdrawnSoFar;

        int refundToEmployer =
            remainingBefore
            - earnedNotWithdrawn
            - minerFee;

        require(refundToEmployer >= 0);

        bytes25 workerLock =
            new LockingBytecodeP2PKH(workerPKH);

        bytes25 employerLock =
            new LockingBytecodeP2PKH(employerPKH);

        require(tx.outputs.length == 2);

        require(tx.outputs[0].value == earnedNotWithdrawn);
        require(tx.outputs[0].lockingBytecode == workerLock);

        require(tx.outputs[1].value == refundToEmployer);
        require(tx.outputs[1].lockingBytecode == employerLock);
    }
}