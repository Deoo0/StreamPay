pragma cashscript ^0.13.0;

contract StreamPay(
    bytes20 employerPKH,
    bytes20 workerPKH,
    int startTime, // unix timestamp, stream genesis (0% vested)
    int endTime, // unix timestamp, stream genesis (100% vested)
    int totalDeposit
) {

    function withdraw(sig workerSig, pubkey workerPk, int amount) {

        require(hash160(workerPk) == workerPKH);
        require(checkSig(workerSig, workerPk));

        require(startTime < endTime);
        require(totalDeposit > 0);

        require(tx.locktime >= startTime);

        int minerFee = 1000;
        int dustLimit = 546;

        int streamBalance = tx.inputs[this.activeInputIndex].value;

        require(streamBalance <= totalDeposit);

        int totalWithdrawn = totalDeposit - streamBalance;

        int vestingDuration = endTime - startTime;
        int elapsedTime = min(tx.locktime - startTime, vestingDuration);
        int vestedAmount = (totalDeposit * elapsedTime) / vestingDuration;

        require(amount > 0);
        require(totalWithdrawn + amount <= vestedAmount);
        
        bytes25 workerLock = new LockingBytecodeP2PKH(workerPKH);

        int updatedStreamBalance = streamBalance - amount - minerFee;

        if (updatedStreamBalance > dustLimit + minerFee) {

            bytes selfLock = tx.inputs[this.activeInputIndex].lockingBytecode;

            require(tx.outputs.length == 2);

            require(tx.outputs[0].value == amount);
            require(tx.outputs[0].lockingBytecode == workerLock);

            require(tx.outputs[1].value == updatedStreamBalance);
            require(tx.outputs[1].lockingBytecode == selfLock);

        } else {
            
            require(tx.outputs.length == 1);

            require( tx.outputs[0].value == streamBalance - minerFee );

            require( tx.outputs[0].lockingBytecode == workerLock );
        }
    }

    function cancel(sig employerSig, pubkey employerPk) {

        require(hash160(employerPk) == employerPKH);
        require(checkSig(employerSig, employerPk));

        require(startTime < endTime);
        require(totalDeposit > 0);

        require(tx.locktime >= startTime);

        int minerFee = 1000;

        int streamBalance = tx.inputs[this.activeInputIndex].value;

        require(streamBalance <= totalDeposit);

        int totalWithdrawn = totalDeposit - streamBalance;

        int vestingDuration = endTime - startTime;
        int elapsedTime = tx.locktime - startTime;

        if (elapsedTime > vestingDuration) {
            elapsedTime = vestingDuration;
        }

        int vestedAmount = (totalDeposit * elapsedTime) / vestingDuration;

        int claimableAmount = vestedAmount - totalWithdrawn;

        int refundToEmployer = streamBalance - claimableAmount - minerFee;

        require(refundToEmployer >= 0);

        bytes25 workerLock = new LockingBytecodeP2PKH(workerPKH);

        bytes25 employerLock = new LockingBytecodeP2PKH(employerPKH);

        require(tx.outputs.length == 2);

        require(tx.outputs[0].value == claimableAmount);
        require(tx.outputs[0].lockingBytecode == workerLock);

        require(tx.outputs[1].value == refundToEmployer);
        require(tx.outputs[1].lockingBytecode == employerLock);
    }
}