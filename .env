# Copy to .env and adjust if needed. scripts/lib/config.js reads these via
# process.env — you'll need a loader (e.g. `node --env-file=.env scripts/...`)
# or `export` them in your shell before running scripts.

# Regtest node RPC connection (matches scripts/start-regtest-node.sh defaults)
BCHN_RPC_HOST=127.0.0.1
BCHN_RPC_PORT=18443
BCHN_RPC_USER=streampay
BCHN_RPC_PASS=streampay

# NOTE: employer/worker private keys are NOT read from env — they're fixed
# dev-only test keys hardcoded in scripts/lib/config.js (same ones used in
# contracts/test/helpers.js), so unit tests and CLI scripts behave
# consistently. Never reuse those keys for anything holding real funds.
